# Exemplo de Variáveis de Ambiente para o Vite
# Renomeie para .env na sua máquina e preencha com as credenciais do seu Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui
VITE_SISTEMA_SLUG="slug-do-seu-sistema"
VITE_SISTEMA_ID="uuid-gerado-no-core-sistemas"
